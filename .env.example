# ===================================================================
# LogiKode — Environment Variables Configuration (.env.example)
# Produk oleh Core Dev Group (https://core-dev-group.my.id)
# ===================================================================

# -------------------------------------------------------------------
# 1. TAUTAN PEMBAYARAN QRIS (Lynk.id Checkout Direct)
# -------------------------------------------------------------------
# Tautan checkout instan untuk masing-masing item mikrotransaksi ramah pelajar.
# Jika dibiarkan kosong, aplikasi memiliki fallback tautan default ke akun kodel-dev.
NEXT_PUBLIC_QRIS_FREEZE_URL="https://lynk.id/kodel-dev/z5xvr8dvgoxj/checkout"
NEXT_PUBLIC_QRIS_REFILL_URL="https://lynk.id/kodel-dev/2m7w9pvvdo93/checkout"
NEXT_PUBLIC_QRIS_UNLIMITED_URL="https://lynk.id/kodel-dev/2qw01g6nvzp3/checkout"

# -------------------------------------------------------------------
# 2. SISTEM VOUCHER DINAMIS BERBASIS ORDER ID LYNK.ID (Solusi B - Modal Rp 0)
# -------------------------------------------------------------------
# Kunci rahasia/salt untuk verifikasi format voucher dinamis:
# Format: FRZ-[SALT]-[ORDER_ID], RFL-[SALT]-[ORDER_ID], UNL-[SALT]-[ORDER_ID]
# Pembeli dapat membeli berulang kali karena setiap order ID di Lynk.id berbeda.
NEXT_PUBLIC_VOUCHER_SALT="CDG"

# -------------------------------------------------------------------
# 3. KODE VOUCHER KUSTOM TAMBAHAN (Opsional untuk Promo/Giveaway)
# -------------------------------------------------------------------
# Kode voucher default bawaan aplikasi (selalu aktif):
# - LOGIFREEZE2K  : Hadiah 1x Streak Freeze
# - LOGIHEART2K   : Hadiah Isi Ulang 5 Hearts Penuh
# - LOGIPRO7D     : Hadiah Unlimited Hearts (7 Hari Penuh)
#
# Kamu bisa menambahkan kode rahasia / event promo baru lewat Vercel Environment Variables:
NEXT_PUBLIC_VOUCHER_FREEZE="PROMOFREEZE"
NEXT_PUBLIC_VOUCHER_REFILL="PROMOHEART"
NEXT_PUBLIC_VOUCHER_UNLIMITED="COREDEVVIP"
