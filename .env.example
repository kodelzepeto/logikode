# ===================================================================
# LogiKode — Environment Variables Configuration (.env.example)
# Produk oleh Core Dev Group (https://core-dev-group.my.id)
# ===================================================================

# -------------------------------------------------------------------
# 1. TAUTAN PEMBAYARAN QRIS (Mayar.id / Lynk.id / Payment Gateway)
# -------------------------------------------------------------------
# Tautan checkout instan untuk masing-masing item mikrotransaksi ramah pelajar.
# Jika dibiarkan kosong, aplikasi memiliki fallback tautan default.
NEXT_PUBLIC_QRIS_FREEZE_URL="https://lynk.id/coredevgroup/freeze-2k"
NEXT_PUBLIC_QRIS_REFILL_URL="https://lynk.id/coredevgroup/hearts-2k"
NEXT_PUBLIC_QRIS_UNLIMITED_URL="https://lynk.id/coredevgroup/unlimited-3k"

# -------------------------------------------------------------------
# 2. KODE VOUCHER KUSTOM TAMBAHAN (Opsional)
# -------------------------------------------------------------------
# Kode voucher default bawaan aplikasi (selalu aktif):
# - LOGIFREEZE2K  : Hadiah 1x Streak Freeze
# - LOGIHEART2K   : Hadiah Isi Ulang 5 Hearts Penuh
# - LOGIPRO7D     : Hadiah Unlimited Hearts (7 Hari Penuh)
#
# Kamu bisa menambahkan kode rahasia / event promo baru lewat Vercel Environment Variables:
NEXT_PUBLIC_VOUCHER_FREEZE="PROMOFREEZE"
NEXT_PUBLIC_VOUCHER_REFILL="PROMOHEART"
NEXT_PUBLIC_VOUCHER_UNLIMITED="COREDEVVIP"
