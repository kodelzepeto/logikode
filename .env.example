# ===================================================================
# LogiKode — Environment Variables Configuration (.env.example)
# Produk oleh Core Dev Group (https://core-dev-group.my.id)
# ===================================================================

# -------------------------------------------------------------------
# 1. TAUTAN PEMBAYARAN QRIS (Lynk.id Checkout Direct)
# -------------------------------------------------------------------
NEXT_PUBLIC_QRIS_FREEZE_URL="https://lynk.id/kodel-dev/z5xvr8dvgoxj/checkout"
NEXT_PUBLIC_QRIS_REFILL_URL="https://lynk.id/kodel-dev/2m7w9pvvdo93/checkout"
NEXT_PUBLIC_QRIS_UNLIMITED_URL="https://lynk.id/kodel-dev/2qw01g6nvzp3/checkout"

# -------------------------------------------------------------------
# 2. UPSTASH REDIS CLOUD DATABASE (Solusi 100% Anti-Curang & Anti-Bocor)
# -------------------------------------------------------------------
# Buat database serverless gratis di https://console.upstash.com:
UPSTASH_REDIS_REST_URL="https://your-upstash-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# -------------------------------------------------------------------
# 3. SISTEM VOUCHER DINAMIS BERBASIS ORDER ID LYNK.ID
# -------------------------------------------------------------------
NEXT_PUBLIC_VOUCHER_SALT="CDG"

# -------------------------------------------------------------------
# 4. KODE VOUCHER KUSTOM TAMBAHAN (Opsional untuk Promo/Giveaway)
# -------------------------------------------------------------------
NEXT_PUBLIC_VOUCHER_FREEZE="PROMOFREEZE"
NEXT_PUBLIC_VOUCHER_REFILL="PROMOHEART"
NEXT_PUBLIC_VOUCHER_UNLIMITED="COREDEVVIP"

# -------------------------------------------------------------------
# 5. SEO & DOMAIN CONFIGURATION
# -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://logi-kode.vercel.app"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
